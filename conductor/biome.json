{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"root": ".."
	},
	"files": {
		"ignoreUnknown": false
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"plugins": [
		{
			"path": "./lint/no-safe-parse-in-commands.grit",
			"includes": ["**/src/*/commands.ts"]
		},
		{
			"path": "./lint/no-append-outside-lifecycle.grit",
			"includes": [
				"**/src/**/*.ts",
				"!**/src/**/*.test.ts",
				"!**/src/*/lifecycle.ts",
				"!**/src/ledger.ts",
				"!**/src/test-support/**"
			]
		},
		{
			"path": "./lint/no-gate-request-for-task.grit",
			"includes": [
				"**/src/**/*.ts",
				"!**/src/gate/lifecycle.ts",
				"!**/src/task/lifecycle.ts"
			]
		}
	],
	"overrides": [
		{
			"includes": ["src/*/commands.ts"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"../ledger.js": {
										"importNames": ["openLedger"],
										"message": "A domain's commands.ts opens the Ledger through withLedger in cli-support.ts, which closes it on every path."
									}
								}
							}
						}
					}
				}
			}
		}
	]
}
